{
  "buildCommand": "prisma generate && prisma db push && next build",
  "framework": "nextjs",
  "regions": ["hkg1", "sin1"],
  "installCommand": "npm install",
  "functions": {
    "app/api/auth/login/route.ts": {
      "maxDuration": 30
    },
    "app/api/auth/accounts/route.ts": {
      "maxDuration": 15
    },
    "app/api/documents/[id]/route.ts": {
      "maxDuration": 60
    },
    "app/api/security/bulk-copy-violation/route.ts": {
      "maxDuration": 15
    },
    "app/api/health/route.ts": {
      "maxDuration": 15
    }
  }
}
