# Database
# 本地开发（Docker）：先运行 npm run db:local
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/headhunter"

# 生产环境（Neon PostgreSQL）：
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# App URL（分享链接、公网访问）
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# 生产示例：NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Real-time collaboration (Partykit)
# 本地：npm run party
NEXT_PUBLIC_PARTYKIT_HOST="localhost:1999"
# 生产：npm run deploy:partykit 后填入
# NEXT_PUBLIC_PARTYKIT_HOST="headhunter-docs-collab.username.partykit.dev"

# Auth — 团队登录（生产环境必须修改）
AUTH_SECRET="change-this-to-a-long-random-string"
DEFAULT_PASSWORD="Lt@202607"
# gray 专用登录密码（与其他成员默认密码不同）
GRAY_PASSWORD="Gr@y202608"
# ADMIN_PASSWORD=""

# AI Summary（可选）
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"

# 本地 ↔ 公网数据同步（可选）
# 启用后：npm run dev 会自动启动同步守护进程
SYNC_ENABLED="false"
# Neon 公网库连接串（与生产 DATABASE_URL 相同）
# SYNC_REMOTE_DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
SYNC_INTERVAL_MS="5000"
SYNC_DEBOUNCE_MS="800"
# 前端轮询刷新侧边栏（需与 SYNC_ENABLED 同时为 true）
NEXT_PUBLIC_SYNC_ENABLED="false"
NEXT_PUBLIC_SYNC_POLL_INTERVAL_MS="5000"

# 安全防护（登录防暴力破解 / 分享链接限流）
# SECURITY_LOGIN_IP_LIMIT=20
# SECURITY_LOGIN_USER_LIMIT=5
# SECURITY_LOGIN_WINDOW_MS=900000
# SECURITY_LOGIN_LOCKOUT_MS=1800000
# SECURITY_SHARE_IP_LIMIT=60
