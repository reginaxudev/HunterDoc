# 本地开发环境变量
# cp .env.example .env

# Database — 本地：npm run db:local
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/headhunter"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Real-time collaboration — 本地：npm run party
NEXT_PUBLIC_PARTYKIT_HOST="localhost:1999"

# Auth
AUTH_SECRET="change-this-to-a-long-random-string"
DEFAULT_PASSWORD="Lt@202607"
GRAY_PASSWORD="Gr@y202608"

# AI Summary（可选）
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# 本地 ↔ 公网同步（可选，仅开发机）
SYNC_ENABLED="false"
# SYNC_REMOTE_DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
SYNC_INTERVAL_MS="5000"
NEXT_PUBLIC_SYNC_ENABLED="false"
NEXT_PUBLIC_SYNC_POLL_INTERVAL_MS="5000"

# 安全防护（可选）
# SECURITY_LOGIN_IP_LIMIT=20
# SECURITY_LOGIN_USER_LIMIT=5
# SECURITY_BULK_COPY_VIOLATION_LIMIT=3
