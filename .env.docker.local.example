# 本地 Docker 环境（由 npm run docker:local 自动复制）
# 复制：cp .env.docker.local.example .env.docker.local

DOCKER_IMAGE=hunterdoc:local
APP_PORT=3000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=headhunter

# compose 会覆盖为指向服务名 postgres；此处仅作文档参考
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/headhunter

NEXT_PUBLIC_APP_URL=http://localhost:3000
# 注意：NEXT_PUBLIC_* 在镜像构建期被内联，compose 的 build args 取自根目录 .env，
# 不读本文件。改协作地址要改根目录 .env 的 NEXT_PUBLIC_PARTYKIT_HOST 后重新构建。
NEXT_PUBLIC_PARTYKIT_HOST=headhunter-docs-collab.reginaxudev-lgtm.partykit.dev

# 必须与根目录 .env 的 AUTH_SECRET 一致：collab token 由本容器签发，
# 由 npm run party 起的 Partykit 校验，而 partykit dev 读的是根目录 .env
AUTH_SECRET=change-this-to-a-long-random-string
DEFAULT_PASSWORD=Lt@202607
GRAY_PASSWORD=Gr@y202608

# 每次启动 upsert 团队账号（本地方便；生产请 false）
RUN_DB_SEED=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
