{
  "name": "hunterdoc",
  "version": "0.3.2",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:stop": "lsof -ti :3000 | xargs kill -9 2>/dev/null || true",
    "dev:reset": "npm run dev:stop && rm -rf .next && npm run dev",
    "party": "partykit dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:local": "docker compose up -d",
    "docker:local": "node scripts/docker-local.mjs",
    "online:proxy": "node scripts/proxy-online.mjs",
    "docker:local:logs": "docker compose -f docker-compose.local.yml logs -f",
    "docker:local:stop": "docker compose -f docker-compose.local.yml down",
    "docker:local:reset": "docker compose -f docker-compose.local.yml down -v && node scripts/docker-local.mjs",
    "db:fix-login": "npx tsx scripts/fix-team-login.mjs",
    "db:reset-gray-password": "npx tsx scripts/reset-user-password.mjs",
    "db:studio": "prisma studio",
    "deploy": "node scripts/deploy.mjs",
    "deploy:partykit": "partykit deploy",
    "deploy:docker": "node scripts/generate-caddyfile.mjs && docker compose -f docker-compose.prod.yml up -d --build",
    "deploy:docker:db": "node scripts/generate-caddyfile.mjs && docker compose -f docker-compose.prod.yml --profile with-db up -d --build",
    "deploy:docker:pull": "node scripts/generate-caddyfile.mjs && docker compose -f docker-compose.prod.yml pull && docker compose -f docker-compose.prod.yml up -d",
    "deploy:docker:build": "docker build -t ghcr.io/reginaxudev/hunterdoc:latest .",
    "deploy:init-env": "node scripts/init-production-env.mjs",
    "deploy:caddy": "node scripts/generate-caddyfile.mjs",
    "deploy:seed": "node scripts/deploy.mjs seed",
    "deploy:secret": "node scripts/deploy.mjs secret",
    "migrate:local-to-neon": "node scripts/migrate-local-to-neon.mjs",
    "sync": "npx tsx scripts/sync-daemon.ts",
    "sync:once": "npx tsx scripts/sync-daemon.ts --once",
    "start": "next start",
    "lint": "next lint"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "@tiptap/extension-collaboration": "^2.11.5",
    "@tiptap/extension-collaboration-cursor": "^2.11.5",
    "@tiptap/extension-highlight": "^2.11.5",
    "@tiptap/extension-image": "^2.11.5",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-mention": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-table": "^2.11.5",
    "@tiptap/extension-table-cell": "^2.11.5",
    "@tiptap/extension-table-header": "^2.11.5",
    "@tiptap/extension-table-row": "^2.11.5",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "@tiptap/suggestion": "^2.27.2",
    "@univerjs/preset-sheets-core": "^0.25.1",
    "@univerjs/preset-sheets-filter": "^0.25.1",
    "@univerjs/preset-sheets-find-replace": "^0.25.1",
    "@univerjs/presets": "^0.25.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.4",
    "lucide-react": "^0.474.0",
    "nanoid": "^5.0.9",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.0.1",
    "uuid": "^11.0.5",
    "xlsx": "^0.18.5",
    "y-partykit": "^0.0.33",
    "yjs": "^13.6.22"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "^15.1.6",
    "partykit": "^0.0.115",
    "prisma": "^6.3.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
