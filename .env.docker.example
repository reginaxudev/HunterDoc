# Docker 生产环境配置
# 复制为 .env.production 后修改：cp .env.docker.example .env.production

# 镜像（GitHub Actions 构建后默认推送到 GHCR）
DOCKER_IMAGE=ghcr.io/reginaxudev/hunterdoc:latest
APP_PORT=3000

# 应用访问地址（分享链接、登录回调）
NEXT_PUBLIC_APP_URL=https://your-domain.com

# 实时协作 Partykit
NEXT_PUBLIC_PARTYKIT_HOST=headhunter-docs-collab.reginaxudev-lgtm.partykit.dev

# 数据库
# 方式 A：使用 compose 内置 PostgreSQL（启动时加 --profile with-db）
# DATABASE_URL=postgresql://postgres:your-strong-password@postgres:5432/headhunter
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your-strong-password
# POSTGRES_DB=headhunter

# 方式 B：外部托管库（Neon / 云 RDS），不启用 with-db profile
DATABASE_URL=postgresql://user:pass@host:5432/headhunter?sslmode=require

# 认证
AUTH_SECRET=change-me-use-npm-run-deploy-secret
DEFAULT_PASSWORD=Lt@202607
GRAY_PASSWORD=Gr@y202608

# 首次部署后初始化账号（在能访问数据库的机器上）：
# DATABASE_URL="postgresql://..." npm run deploy:seed

# AI 摘要（可选）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 前端同步轮询（一般生产关闭）
NEXT_PUBLIC_SYNC_ENABLED=false
NEXT_PUBLIC_SYNC_POLL_INTERVAL_MS=5000
