# Docker 生产环境配置
# 快速初始化：node scripts/init-production-env.mjs
# 或手动复制：cp .env.docker.example .env.production

# 镜像（GitHub Actions 构建后默认推送到 GHCR）
DOCKER_IMAGE=ghcr.io/reginaxudev/hunterdoc:latest

# ========== 域名 / HTTPS（Caddy 自动证书）==========
# 留空 APP_DOMAIN 时仅 HTTP :80，可用服务器 IP 访问
APP_DOMAIN=doc.example.com
ACME_EMAIL=you@example.com
CADDY_MAX_BODY=50MB

# 应用访问地址（须与 APP_DOMAIN 一致，含 https://）
NEXT_PUBLIC_APP_URL=https://doc.example.com

# 实时协作 Partykit
NEXT_PUBLIC_PARTYKIT_HOST=headhunter-docs-collab.reginaxudev-lgtm.partykit.dev

# ========== 数据库 ==========
# 方式 A：Compose 内置 PostgreSQL → npm run deploy:docker:db
# DATABASE_URL=postgresql://postgres:your-strong-password@postgres:5432/headhunter
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your-strong-password
# POSTGRES_DB=headhunter

# 方式 B：外部 Neon / 云 RDS（推荐）
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ========== 认证 ==========
# 运行 node scripts/init-production-env.mjs 会自动生成 AUTH_SECRET
AUTH_SECRET=change-me-use-npm-run-deploy-secret
DEFAULT_PASSWORD=Lt@202607
GRAY_PASSWORD=Gr@y202608

# 首次部署后初始化账号：
# DATABASE_URL="postgresql://..." npm run deploy:seed

# AI 摘要（可选）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

NEXT_PUBLIC_SYNC_ENABLED=false
NEXT_PUBLIC_SYNC_POLL_INTERVAL_MS=5000
